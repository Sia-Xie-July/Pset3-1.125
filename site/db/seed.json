      "source_id": 2,
      "status": "verified",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 3,
      "design_id": 1,
      "claim_text": "IT design load is 20 MW, including compute, storage and IT networking.",
      "claim_type": "assumption",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 4,
      "design_id": 1,
      "claim_text": "The proposed PUE target is 1.25; actual seasonal and load-dependent performance is unverified.",
      "claim_type": "assumption",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 5,
      "design_id": 1,
      "claim_text": "Baseline operating time is 8,760 hours with continuous design load for the initial energy calculation.",
      "claim_type": "assumption",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 6,
      "design_id": 1,
      "claim_text": "20 MW × 1.25 = 25 MW facility electrical load.",
      "claim_type": "calculation",
      "source_id": null,
      "status": "calculated",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 7,
      "design_id": 1,
      "claim_text": "25 MW × 8,760 hours ÷ 1,000 = 219 GWh/year under continuous baseline load.",
      "claim_type": "calculation",
      "source_id": null,
      "status": "calculated",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 8,
      "design_id": 1,
      "claim_text": "Use Kajaani, Kainuu, Finland as the main design case; compare Québec, Canada and Singapore.",
      "claim_type": "design_decision",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 9,
      "design_id": 1,
      "claim_text": "Use grid primary supply, UPS and modular N+1 diesel standby generation; assess independent distribution paths.",
      "claim_type": "design_decision",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 10,
      "design_id": 1,
      "claim_text": "Target 10-minute UPS support and 48-hour full-facility backup; equipment, fuel and switching studies are pending.",
      "claim_type": "assumption",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 11,
      "design_id": 1,
      "claim_text": "At 25 MW, ten minutes requires 4.17 MWh delivered and 48 hours requires 1,200 MWh, before losses and reserves.",
      "claim_type": "calculation",
      "source_id": null,
      "status": "calculated",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 12,
      "design_id": 1,
      "claim_text": "Use direct-to-chip GPU cooling, residual air cooling, closed loops and dry coolers; supplement with mechanical refrigeration when needed.",
      "claim_type": "design_decision",
      "source_id": 3,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 13,
      "design_id": 1,
      "claim_text": "Prefer no routine evaporative cooling towers; filling, maintenance, sanitation and fire water are still needed.",
      "claim_type": "design_decision",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 14,
      "design_id": 1,
      "claim_text": "Plan two physically diverse external fiber routes, provisionally 100 Gbit/s each, and a separate internal GPU fabric.",
      "claim_type": "assumption",
      "source_id": null,
      "status": "proposed",
      "updated_at": "2026-10-05T19:49:46Z"
    },
    {
      "id": 15,
      "design_id": 1,
      "claim_text": "Purchase grid electricity and assess renewable contracts; no dedicated onsite solar, wind or gas in the initial operating case.",
      "claim_type": "design_decision",
